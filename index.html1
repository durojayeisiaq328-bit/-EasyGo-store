
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>EazyGo Solution | Shop Easy. Live Better.</title>
<style>:root{--blue:#1249a3;--deep:#0a2a61;--orange:#ff861c;--ink:#18243b;--muted:#64748b;--line:#e2e8f0;--bg:#f5f7fb}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font-family:system-ui,-apple-system,Arial,sans-serif}a{color:inherit;text-decoration:none}button,input{font:inherit}button{cursor:pointer}.top{background:var(--deep);color:white;text-align:center;padding:9px;font-size:13px}.header{background:var(--blue);color:white;padding:18px max(16px,calc((100% - 1200px)/2));display:flex;gap:20px;align-items:center;flex-wrap:wrap}.brand{font-size:25px;font-weight:900;line-height:1}.brand span{color:var(--orange)}.brand small{display:block;font-size:11px;font-weight:500;margin-top:7px;color:#e2edff}.search{display:flex;flex:1;min-width:230px;border-radius:12px;overflow:hidden;background:white}.search input{border:0;padding:14px;width:100%;min-width:0;outline:none}.search button,.primary{border:0;background:var(--orange);color:#18243b;font-weight:800;padding:13px 18px}.cart-link{font-weight:800;white-space:nowrap}.nav{display:flex;gap:24px;overflow:auto;white-space:nowrap;background:#0d3c89;color:white;padding:12px max(16px,calc((100% - 1200px)/2));font-size:14px}.wrap{max-width:1200px;margin:auto;padding:22px 16px}.hero{background:linear-gradient(120deg,#0a2a61,#1659bf);color:white;border-radius:22px;padding:44px 40px;min-height:300px;display:flex;align-items:center;justify-content:space-between;gap:20px}.hero h1{font-size:clamp(30px,5vw,52px);line-height:1.1;margin:12px 0}.hero p{max-width:560px;line-height:1.65;color:#e0eaff}.hero .art{font-size:90px;text-align:center;min-width:160px}.eyebrow{color:#ffd09f;font-size:13px;font-weight:800;letter-spacing:2px;text-transform:uppercase}.btn{display:inline-block;border-radius:10px;padding:12px 18px;font-weight:800;border:0}.primary{border-radius:10px}.secondary{background:white;color:var(--blue)}.hero-controls{display:flex;gap:8px;margin-top:18px}.dot{border:1px solid #b5c9ee;background:transparent;border-radius:50%;height:12px;width:12px;padding:0}.dot.active{background:var(--orange);border-color:var(--orange)}.notice{background:#fff8e8;border:1px solid #f6d996;border-radius:12px;padding:15px;margin:18px 0;line-height:1.55;font-size:14px}.heading{display:flex;align-items:end;justify-content:space-between;gap:15px;margin:32px 0 15px}.heading h2{margin:0;font-size:24px}.heading p{margin:6px 0 0;color:var(--muted)}.heading a{color:var(--blue);font-weight:800}.categories{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}.category{background:white;border:1px solid var(--line);border-radius:15px;padding:20px 10px;text-align:center;font-weight:750}.category:hover,.card:hover{border-color:#ffbd83;box-shadow:0 6px 20px #0c36700f}.category .icon{display:block;font-size:33px;margin-bottom:10px}.products{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px}.card{background:white;border:1px solid var(--line);border-radius:16px;overflow:hidden;display:flex;flex-direction:column}.picture{min-height:155px;background:linear-gradient(135deg,#e8f0ff,#fff4e9);display:grid;place-items:center;font-size:65px;position:relative}.badge{position:absolute;top:10px;left:10px;font-size:11px;background:white;border-radius:7px;padding:5px 7px;font-weight:800;color:#8a5a15}.card-body{padding:15px;display:flex;flex-direction:column;flex:1}.label{color:var(--blue);font-size:11px;font-weight:900;text-transform:uppercase}.card h3{font-size:15px;line-height:1.4;min-height:42px;margin:9px 0}.price{font-weight:900;font-size:20px;color:var(--deep)}.small{font-size:11px;color:#9a6b23;margin:5px 0 12px}.card button{margin-top:auto;border:0;background:var(--orange);font-weight:800;padding:11px;border-radius:9px}.cart{background:white;border:1px solid var(--line);padding:22px;border-radius:17px;margin-top:34px}.cart h2{margin-top:0}.cart-row{display:grid;grid-template-columns:1fr auto auto;gap:12px;align-items:center;padding:13px 0;border-bottom:1px solid var(--line)}.qty{display:flex;align-items:center;gap:10px}.qty button{background:#eef3fa;border:1px solid var(--line);border-radius:6px;width:30px;height:30px}.remove{background:none;border:0;color:#aa3030}.total{display:flex;justify-content:space-between;font-weight:900;font-size:19px;margin:20px 0}.cart-actions{display:flex;gap:10px;flex-wrap:wrap}.cart-actions button{border:0;border-radius:9px;padding:13px 17px;font-weight:800}.muted{color:var(--muted);font-size:13px;line-height:1.6}.features{display:grid;grid-template-columns:repeat(3,1fr);gap:13px;margin-top:22px}.feature{background:white;border:1px solid var(--line);border-radius:14px;padding:19px}.feature b{display:block;margin-bottom:8px}.feature p{margin:0;color:var(--muted);font-size:13px;line-height:1.5}.footer{background:var(--deep);color:white;margin-top:40px;padding:30px 16px}.footer-inner{max-width:1200px;margin:auto;display:flex;gap:35px;justify-content:space-between;flex-wrap:wrap}.footer p{color:#d6e2f4;line-height:1.6}.footer a{color:#ffbd80}.sticky{display:none}@media(max-width:850px){.products{grid-template-columns:repeat(3,1fr)}.categories{grid-template-columns:repeat(3,1fr)}.hero .art{font-size:70px;min-width:100px}.search{order:3;flex-basis:100%}}@media(max-width:570px){.header{padding:15px 12px;gap:12px}.brand{font-size:20px;flex:1}.nav{padding:11px 12px}.wrap{padding:16px 12px}.hero{padding:30px 20px;min-height:280px}.hero .art{display:none}.hero h1{font-size:34px}.categories,.products{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.picture{min-height:110px;font-size:45px}.card-body{padding:11px}.card h3{font-size:13px}.price{font-size:16px}.heading h2{font-size:20px}.cart-row{grid-template-columns:1fr auto}.cart-row .qty{grid-column:1}.cart-row .remove{grid-column:2;grid-row:1 / span 2}.features{grid-template-columns:1fr}.sticky{display:flex;position:sticky;bottom:0;background:white;border-top:1px solid var(--line);padding:10px 12px;align-items:center;justify-content:space-between;gap:10px;box-shadow:0 -5px 20px #0001}.sticky a{background:var(--orange);border-radius:9px;padding:10px;font-weight:800}}
</style></head><body><div class="top">💙 Welcome to EazyGo Solution • Shop Easy. Live Better.</div><header class="header"><a class="brand" href="index.html">EazyGo <span>Solution</span><small>Quality Products. Reliable Service.</small></a><form class="search" id="searchForm"><input id="searchInput" type="search" placeholder="Search products and categories..." aria-label="Search products"><button>Search</button></form><a class="cart-link" href="#cart">🛒 Cart (<span id="cartCount">0</span>)</a></header><nav class="nav"><a href="index.html">Home</a><a href="products.html">All Products</a><a href="#categories">Categories</a><a href="#featured">Featured</a><a href="#cart">Shopping Cart</a><a href="#contact">Contact</a></nav><main class="wrap"><section class="hero" aria-label="Featured promotions"><div><div class="eyebrow" id="slideEyebrow">Welcome to EazyGo</div><h1 id="slideTitle">Shop Easy.<br>Live Better.</h1><p id="slideText">Discover electronics, appliances, fashion, furniture and everyday essentials in one convenient place.</p><a class="btn primary" id="slideLink" href="products.html">Explore products →</a><div class="hero-controls" aria-label="Choose promotional slide"><button class="dot active" aria-label="Slide 1" data-slide="0"></button><button class="dot" aria-label="Slide 2" data-slide="1"></button><button class="dot" aria-label="Slide 3" data-slide="2"></button></div></div><div class="art" id="slideArt" aria-hidden="true">🛍️📱</div></section><div class="notice"><strong>Important price notice:</strong> The products and prices displayed on this demo website are sample placeholders and are <strong>not confirmed offers</strong>. Please verify prices, availability, delivery charges and payment instructions with EazyGo Solution. This website does not collect online payments; WhatsApp checkout prepares an enquiry message.</div><section id="categories"><div class="heading"><div><h2>Shop by category</h2><p>Find what you need quickly.</p></div></div><div class="categories" id="categoryGrid"></div></section><section id="featured"><div class="heading"><div><h2>Featured products</h2><p>Explore sample listings while our catalogue is being prepared.</p></div><a href="products.html">View all →</a></div><div class="products" id="productGrid"></div></section><section class="cart" id="cart"><h2>🛒 Your shopping cart</h2><p id="cartEmpty" class="muted">Your cart is empty. Add a product to get started.</p><div id="cartItems"></div><div class="total"><span>Estimated total</span><span id="cartTotal">₦0</span></div><div class="cart-actions"><button class="primary" id="checkoutBtn">Send enquiry on WhatsApp</button><button id="clearCartBtn" style="background:#edf2f9">Clear cart</button></div><p class="muted">No payment is collected here. Your WhatsApp message will request confirmation of product availability, current pricing, delivery fees and payment instructions.</p></section><div class="features"><div class="feature"><b>🛍️ Simple shopping</b><p>Browse categories and organise products in your cart.</p></div><div class="feature"><b>💬 WhatsApp enquiries</b><p>Contact our team to confirm your order details.</p></div><div class="feature"><b>📱 Mobile friendly</b><p>Explore EazyGo on your phone, tablet or computer.</p></div></div></main><footer class="footer" id="contact"><div class="footer-inner"><div><strong>EazyGo Solution</strong><p>Shop Easy. Live Better.<br>Quality Products. Reliable Service.</p></div><div><strong>Contact & enquiries</strong><p>WhatsApp: 09162884848<br><a href="https://wa.me/2349162884848" target="_blank" rel="noopener">Chat with EazyGo Solution →</a></p></div></div></footer><div class="sticky"><span>Cart: <strong id="mobileTotal">₦0</strong></span><a href="#cart">View cart (<span id="mobileCount">0</span>)</a></div><script>
const PRODUCTS=[{id:'e1',name:'Wireless Bluetooth Headphones',category:'Electronics',price:18500,emoji:'🎧'},{id:'g1',name:'2-Burner Tabletop Gas Cooker',category:'Gas Cookers',price:32000,emoji:'🔥'},{id:'p1',name:'Android Smartphone (Sample)',category:'Phones',price:145000,emoji:'📱'},{id:'l1',name:'Everyday Laptop (Sample)',category:'Laptops',price:385000,emoji:'💻'},{id:'f1',name:'Casual T-Shirt',category:'Fashion',price:7500,emoji:'👕'},{id:'s1',name:'Everyday Sneakers',category:'Shoes',price:18000,emoji:'👟'},{id:'b1',name:'Everyday Shoulder Bag',category:'Bags',price:12500,emoji:'👜'},{id:'k1',name:'Electric Blender',category:'Kitchen Appliances',price:28500,emoji:'🥤'},{id:'h1',name:'LED Rechargeable Lamp',category:'Home Products',price:9500,emoji:'💡'},{id:'e2',name:'Portable Bluetooth Speaker',category:'Electronics',price:22000,emoji:'🔊'},{id:'k2',name:'Electric Kettle',category:'Kitchen Appliances',price:14500,emoji:'🫖'},{id:'h2',name:'Bedsheet Set (Sample)',category:'Home Products',price:16000,emoji:'🛏️'}];
const CATEGORIES=[['Electronics','📺'],['Gas Cookers','🔥'],['Phones','📱'],['Laptops','💻'],['Fashion','👕'],['Shoes','👟'],['Bags','👜'],['Kitchen Appliances','🍳'],['Home Products','🏠']];const fmt=n=>'₦'+Number(n).toLocaleString('en-NG');let cart={};try{cart=JSON.parse(localStorage.getItem('eazygoCart')||'{}')||{}}catch(e){cart={}}const grid=document.getElementById('productGrid');function save(){try{localStorage.setItem('eazygoCart',JSON.stringify(cart))}catch(e){}renderCart()}function card(p){return `<article class="card"><div class="picture"><span class="badge">Sample price</span>${p.emoji}</div><div class="card-body"><div class="label">${p.category}</div><h3>${p.name}</h3><div class="price">${fmt(p.price)}</div><div class="small">UNCONFIRMED SAMPLE PRICE</div><button onclick="addToCart('${p.id}')">＋ Add to cart</button></div></article>`}function showProducts(list=PRODUCTS){grid.innerHTML=list.length?list.slice(0,8).map(card).join(''):'<p>No matching products. Try another search.</p>'}function addToCart(id){cart[id]=(cart[id]||0)+1;save()}function changeQty(id,delta){cart[id]=(cart[id]||0)+delta;if(cart[id]<=0)delete cart[id];save()}function removeItem(id){delete cart[id];save()}function renderCart(){let entries=Object.entries(cart).filter(([id,q])=>PRODUCTS.some(p=>p.id===id)&&q>0);let count=entries.reduce((s,[id,q])=>s+q,0),total=entries.reduce((s,[id,q])=>s+PRODUCTS.find(p=>p.id===id).price*q,0);document.getElementById('cartCount').textContent=count;document.getElementById('mobileCount').textContent=count;document.getElementById('cartTotal').textContent=fmt(total);document.getElementById('mobileTotal').textContent=fmt(total);document.getElementById('cartEmpty').style.display=entries.length?'none':'block';document.getElementById('cartItems').innerHTML=entries.map(([id,q])=>{let p=PRODUCTS.find(x=>x.id===id);return `<div class="cart-row"><div><b>${p.emoji} ${p.name}</b><div class="muted">${fmt(p.price)} each · ${fmt(p.price*q)} subtotal</div></div><div class="qty"><button onclick="changeQty('${id}',-1)" aria-label="Decrease quantity">−</button><b>${q}</b><button onclick="changeQty('${id}',1)" aria-label="Increase quantity">+</button></div><button class="remove" onclick="removeItem('${id}')">Remove</button></div>`}).join('')}function checkout(){let entries=Object.entries(cart).filter(([id,q])=>PRODUCTS.some(p=>p.id===id)&&q>0);if(!entries.length){alert('Your cart is empty.');return}let total=0;let lines=entries.map(([id,q])=>{let p=PRODUCTS.find(x=>x.id===id),sub=p.price*q;total+=sub;return `• ${p.name} x${q} — ${fmt(sub)} (sample price)`});let msg=`Hello EazyGo Solution! I would like to enquire about:\n\n${lines.join('\n')}\n\nEstimated total: ${fmt(total)}\n\nI understand these prices are unconfirmed. Please confirm prices, availability, delivery fee and payment instructions.\nName:\nDelivery location:`;window.open('https://wa.me/2349162884848?text='+encodeURIComponent(msg),'_blank','noopener')}document.getElementById('checkoutBtn').addEventListener('click',checkout);document.getElementById('clearCartBtn').addEventListener('click',()=>{if(confirm('Clear all items?')){cart={};save()}});document.getElementById('searchForm').addEventListener('submit',e=>{e.preventDefault();let q=document.getElementById('searchInput').value.trim().toLowerCase();showProducts(PRODUCTS.filter(p=>(p.name+' '+p.category).toLowerCase().includes(q)));document.getElementById('featured').scrollIntoView({behavior:'smooth'})});document.getElementById('categoryGrid').innerHTML=CATEGORIES.map(([name,icon])=>`<button class="category" data-category="${name}"><span class="icon">${icon}</span>${name}</button>`).join('')+'<a class="category" href="products.html"><span class="icon">🛍️</span>View all</a>';document.querySelectorAll('[data-category]').forEach(b=>b.addEventListener('click',()=>{showProducts(PRODUCTS.filter(p=>p.category===b.dataset.category));document.getElementById('featured').scrollIntoView({behavior:'smooth'})}));
const slides=[{eyebrow:'Welcome to EazyGo Solution',title:'Shop Easy.<br>Live Better.',text:'Explore electronics, home essentials, fashion and more—all in one convenient place.',art:'🛍️📱'},{eyebrow:'Electronics & appliances',title:'Upgrade your<br>everyday life.',text:'Discover product categories for phones, laptops, kitchen appliances and more.',art:'📺❄️'},{eyebrow:'Your shopping destination',title:'More choice.<br>Less hassle.',text:'Browse your favourites and send an enquiry to confirm prices and availability.',art:'🛋️👟'}];let currentSlide=0;function setSlide(i){currentSlide=i;let s=slides[i];document.getElementById('slideEyebrow').textContent=s.eyebrow;document.getElementById('slideTitle').innerHTML=s.title;document.getElementById('slideText').textContent=s.text;document.getElementById('slideArt').textContent=s.art;document.querySelectorAll('.dot').forEach((d,j)=>d.classList.toggle('active',j===i))}document.querySelectorAll('.dot').forEach(d=>d.addEventListener('click',()=>setSlide(Number(d.dataset.slide))));if(!window.matchMedia('(prefers-reduced-motion: reduce)').matches){setInterval(()=>setSlide((currentSlide+1)%slides.length),6000)}showProducts();renderCart();
</script></body></html>
